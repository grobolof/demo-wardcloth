<article class="mr-card">
  <a class="mr-card__image" href="{{ href }}">
    <img src="{{ thumb }}" alt="{{ name }}" title="{{ name }}"/>
  </a>
  <h3 class="mr-card__name"><a href="{{ href }}">{{ name }}</a></h3>
  <p class="mr-card__stock{% if not stock %} is-out{% endif %}">{{ stock ? 'В наличии' : 'Нет в наличии' }}</p>
  <div class="mr-card__foot">
    {% if price %}
      <div class="mr-card__price">
        {% if not special %}
          <span>{{ price }}</span>
        {% else %}
          <span>{{ special }}</span>
          <s>{{ price }}</s>
        {% endif %}
      </div>
    {% else %}
      <div class="mr-card__price"></div>
    {% endif %}
    <form method="post" data-oc-toggle="ajax" data-oc-load="{{ cart }}" data-oc-target="#cart">
      <button type="submit" formaction="{{ wishlist_add }}" aria-label="В избранное">
        <svg viewBox="0 0 24 24"><path d="M12 19s-7-4.4-7-9a4 4 0 0 1 7-2 4 4 0 0 1 7 2c0 4.6-7 9-7 9z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
      </button>
      <button type="submit" formaction="{{ compare_add }}" aria-label="Сравнить">
        <svg viewBox="0 0 24 24"><path d="M7 4v12M4.5 7.5 7 4l2.5 3.5M17 20V8M14.5 16.5 17 20l2.5-3.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button class="is-cart" type="submit" formaction="{{ cart_add }}" aria-label="В корзину">
        <svg viewBox="0 0 24 24"><path d="M6.5 8h11l-1 11h-9l-1-11z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M9 8V7a3 3 0 0 1 6 0v1" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
      </button>
      <input type="hidden" name="product_id" value="{{ product_id }}"/>
      <input type="hidden" name="quantity" value="{{ minimum }}"/>
    </form>
  </div>
</article>
